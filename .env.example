# Copy this file to .env.local and fill in values.

# Required
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: Override base URL for OpenAI-compatible providers
# Example: https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Separate credentials for non-transcribe (text) models (summaries/series)
# Use this if you want routing to a second provider or a different key.
# OPENAI_TEXT_API_KEY=sk-your-text-api-key-here
# OPENAI_TEXT_BASE_URL=https://your-provider.example.com/v1

# Optional: Speech-to-text model
# Recommended default for batch MP4: gpt-4o-mini-transcribe
# High quality: gpt-4o-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Optional: Model for transcript "Aufbereitung" (summaries, questions, structure)
# Example: gpt-5.1-mini
OPENAI_SUMMARY_MODEL=gpt-5-mini

# Optional: Model for series ordering + compilation (combined output)
# Example: gpt-5.1-mini
OPENAI_SERIES_MODEL=gpt-5-mini

# Optional: Model for final reduce step (map-reduce) when many videos
# Example: gpt-4.1
OPENAI_SERIES_FINAL_MODEL=gpt-4.1

# Optional: Series chunk size for map step (chapters per chunk)
SERIES_CHUNK_SIZE=4

# Optional: Skip LLM compile if the deterministic series markdown is larger than this
MAX_SERIES_COMPILE_CHARS=60000

# Optional: Filesystem cache directory
CACHE_DIR=.cache/lecture-notes-app
